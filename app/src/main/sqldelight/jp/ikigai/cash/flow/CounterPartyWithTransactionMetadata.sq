CREATE VIEW IF NOT EXISTS CounterPartyWithTransactionMetadata AS
SELECT
    CounterParty.*,
    COUNT(`Transaction`.transactionId) AS transactionCount,
    MAX(`Transaction`.transactionDateTime) AS lastUsed
FROM CounterParty
LEFT JOIN `Transaction` ON CounterParty.counterPartyId = `Transaction`.transactionCounterPartyId
GROUP BY CounterParty.counterPartyId;

getTransactionCount:
SELECT transactionCount FROM CounterPartyWithTransactionMetadata WHERE counterPartyId = :counterPartyId;

getByIds:
SELECT * FROM CounterPartyWithTransactionMetadata WHERE counterPartyId IN :ids;

getAllCounterPartiesSortedByTransactionCountDesc:
SELECT * FROM CounterPartyWithTransactionMetadata ORDER BY transactionCount DESC;

getAllCounterPartiesExceptIdSortedByTransactionCountDesc:
SELECT * FROM CounterPartyWithTransactionMetadata WHERE counterPartyId != :id ORDER BY transactionCount DESC;

getCounterParties:
SELECT * FROM CounterPartyWithTransactionMetadata WHERE counterPartyName LIKE '%' || :searchText || '%' COLLATE NOCASE ORDER BY
CASE WHEN :sortField = 'counterPartyName' AND :sortDirection = 'ASC' THEN CounterPartyWithTransactionMetadata.counterPartyName END ASC,
CASE WHEN :sortField = 'counterPartyName' AND :sortDirection = 'DESC' THEN CounterPartyWithTransactionMetadata.counterPartyName END DESC,
CASE WHEN :sortField = 'transactionCount' AND :sortDirection = 'ASC' THEN CounterPartyWithTransactionMetadata.transactionCount END ASC,
CASE WHEN :sortField = 'transactionCount' AND :sortDirection = 'DESC' THEN CounterPartyWithTransactionMetadata.transactionCount END DESC,
CASE WHEN :sortField = 'lastUsed' AND :sortDirection = 'ASC' THEN CounterPartyWithTransactionMetadata.lastUsed END ASC,
CASE WHEN :sortField = 'lastUsed' AND :sortDirection = 'DESC' THEN CounterPartyWithTransactionMetadata.lastUsed END DESC;